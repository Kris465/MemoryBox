#!/bin/bash

# Sound Terminal launcher script
# This script activates the virtual environment and runs the sound terminal

# Find the sound_term project directory by looking for the venv there
PROJECT_DIR=$(find $HOME -path "*/sound_term/venv" -type d 2>/dev/null | head -n 1 | xargs dirname)

if [ -z "$PROJECT_DIR" ]; then
    # If not found, try to find it in the home directory
    if [ -d "$HOME/repos/sound_term/venv" ]; then
        PROJECT_DIR="$HOME/repos/sound_term"
    elif [ -d "$HOME/sound_term/venv" ]; then
        PROJECT_DIR="$HOME/sound_term"
    else
        echo "Error: Cannot find sound_term project directory with virtual environment."
        echo "Please make sure you have installed the project correctly."
        exit 1
    fi
fi

# Path to the virtual environment
VENV_PATH="$PROJECT_DIR/venv"

# Check if virtual environment exists
if [ ! -d "$VENV_PATH" ]; then
    echo "Error: Virtual environment not found at $VENV_PATH"
    echo "Please run the following commands to set up the environment:"
    echo "  cd $PROJECT_DIR"
    echo "  python -m venv venv"
    echo "  source venv/bin/activate"
    echo "  pip install numpy sounddevice pyaudio"
    exit 1
fi

# Activate the virtual environment
source "$VENV_PATH/bin/activate"

# Check if required packages are installed
python -c "import numpy, sounddevice" 2>/dev/null
if [ $? -ne 0 ]; then
    echo "Required Python packages not found. Installing..."
    pip install numpy sounddevice pyaudio
fi

# Run the sound terminal
python -m sound_term.main

# Deactivate the virtual environment
deactivate